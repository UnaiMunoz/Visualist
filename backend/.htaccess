# Turn on the rewrite engine
RewriteEngine On

# If the request is for a real directory or file, don't rewrite
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# If the request is for the API, route to index.php
RewriteRule ^api/(.*)$ index.php [L]

# Enable CORS headers for API
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "http://localhost:5173"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header set Access-Control-Allow-Credentials "true"
</IfModule>

# For security: deny access to .htaccess files
<Files .htaccess>
    Order Allow,Deny
    Deny from all
</Files>

# For security: deny access to .php files in the includes directory
<FilesMatch "^includes/.*\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# For security: deny access to the config directory
<IfModule mod_rewrite.c>
    RewriteRule ^config/ - [F,L]
</IfModule>